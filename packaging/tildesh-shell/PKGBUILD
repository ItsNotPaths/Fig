# The visible desktop: wweft surfaces, the theme engine, and the palettes and
# setters vendored from omarchy.
#
# Surfaces go to /etc/skel because wweft reads ~/.config/wweft and nowhere
# else, so a user's copy is the only copy that runs. Themes and setters are
# installed rather than copied: nobody edits those.
pkgname=tildesh-shell
pkgver=${PKGVER:?PKGVER is not set}
pkgrel=1
pkgdesc="tildesh shell surfaces, the theme engine, and omarchy's themes"
arch=('any')
url="https://github.com/ItsNotPaths/tildesh"
license=('MIT')
depends=('wweft' 'socat')
options=('!strip' '!debug')

package() {
	cp -a "${STAGE:?STAGE is not set}"/. "$pkgdir"/
}
