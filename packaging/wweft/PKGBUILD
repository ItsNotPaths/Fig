# Built on the host by wweft's own build.sh. This file only wraps what
# packaging/build-packages.sh already staged.
pkgname=wweft
pkgver=${PKGVER:?PKGVER is not set}
pkgrel=1
pkgdesc="Wren surfaces on wlr-layer-shell"
arch=('x86_64')
url="https://github.com/ItsNotPaths/wweft"
license=('MIT')
depends=('wayland' 'libxkbcommon' 'libffi')
options=('!strip' '!debug')

package() {
	cp -a "${STAGE:?STAGE is not set}"/. "$pkgdir"/
}
