# micro's colourscheme, from the palette. ~/.config/micro/colorschemes/
# tildesh.micro links here, and settings.json names it.
#
# A running micro does not reread this. The next one does.
color-link default "#d4be98,#282828"
color-link comment "#665c54"
color-link constant "#d3869b"
color-link constant.string "#a9b665"
color-link constant.string.char "#a9b665"
color-link constant.number "#e1875c"
color-link constant.bool "#d3869b"
color-link identifier "#7daea3"
color-link identifier.class "#d8a657"
color-link identifier.var "#d4be98"
color-link statement "#ea6962"
color-link preproc "#89b482"
color-link type "#d8a657"
color-link type.keyword "#ea6962"
color-link special "#e1875c"
color-link symbol "#d4be98"
color-link symbol.brackets "#bdae93"
color-link symbol.tag "#7daea3"
color-link underlined "#d3869b"
color-link error "bold #ea6962"
color-link todo "bold #d8a657"
color-link diff-added "#a9b665"
color-link diff-modified "#d8a657"
color-link diff-deleted "#ea6962"
color-link gutter-error "#ea6962"
color-link gutter-warning "#d8a657"
color-link line-number "#665c54,#282828"
color-link current-line-number "#7daea3,#282828"
color-link cursor-line "#3c3836"
color-link color-column "#3c3836"
color-link indent-char "#665c54"
color-link selection "#d4be98,#504945"
color-link statusline "#282828,#7daea3"
color-link tabbar "#282828,#7daea3"
color-link scrollbar "#665c54"
color-link divider "#665c54"
