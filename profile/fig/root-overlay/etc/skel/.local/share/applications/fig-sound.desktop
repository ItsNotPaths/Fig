[Desktop Entry]
# TEMPORARY. Seeds for the launcher, so it has more than foot and mpv
# to list while it is being built. Delete this directory when real
# applications are installed.
Type=Application
Name=Sound
Exec=sh -c 'pactl list short sinks; printf "\n[any key]"; read -rsn1'
Terminal=true
Icon=audio-volume-high
Categories=System;
