#!/bin/sh
# fig-selftest — what the image claims, checked on the image.
#
# hedl runs on the headless wlroots backend, so this needs no GPU, no seat and
# no monitor. Run it over ssh, in a VM, or from tty2 while the desktop is up.
#
# It got shorter when sway left. Sway's IPC is JSON over a socket, so the old
# version had to check the seed commands, the field names each seed carries and
# whether the event stream was one object a line. hedl publishes kipp, which is
# the format everything downstream already speaks, so there is nothing to seed,
# nothing to frame and nothing to translate. What is left is the seam itself.
#
# Each check prints one line, kind first:
#   ok <name>
#   not ok <name>	<why>
#   skip <name>	<why>
#
# Exit status is the number of failures.
set -u

fails=0
ok()   { printf 'ok\t%s\n' "$1"; }

# ---------------------------------------------------------------- a clean exit
#
# `quit`, not a signal. Tearing the compositor down is its own code path: it
# removes every listener it added, and one left behind makes wlroots abort
# rather than return. Two such bugs reached a laptop because everything here
# had only ever killed hedl, which never runs that path.
#
# A function because the script has more than one way out, and the run that
# skips kippsrv is exactly the run a person does on a half-built image.
#
# 134 is an assertion and 139 a segfault. Both are worth naming: "hedl did not
# come back" is not a useful thing to read at 1am.
hedlquit() {
	[ -n "$hedl_pid" ] || return 0
	printf 'quit\n' > "$dir/cmd" 2>/dev/null
	i=0
	while [ "$i" -lt 50 ]; do
		kill -0 "$hedl_pid" 2>/dev/null || break
		sleep 0.2
		i=$((i + 1))
	done
	if kill -0 "$hedl_pid" 2>/dev/null; then
		bad "hedl-quit" "still running 10s after quit"
	else
		wait "$hedl_pid" 2>/dev/null
		rc=$?
		case "$rc" in
		0)   ok "hedl-quit" ;;
		134) bad "hedl-quit" "aborted on an assertion: $(grep -i assert "$tmp/hedl.log" | tail -1)" ;;
		139) bad "hedl-quit" "segfaulted while tearing down" ;;
		*)   bad "hedl-quit" "exited $rc" ;;
		esac
	fi
	hedl_pid=""
}

bad()  { printf 'not ok\t%s\t%s\n' "$1" "$2"; fails=$((fails + 1)); }
skip() { printf 'skip\t%s\t%s\n' "$1" "$2"; }

tmp=$(mktemp -d)
hedl_pid=""
kipp_pid=""
cleanup() {
	[ -n "$kipp_pid" ] && kill "$kipp_pid" 2>/dev/null
	[ -n "$hedl_pid" ] && kill "$hedl_pid" 2>/dev/null
	rm -rf "$tmp"
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------- the tools

for t in hedl socat; do
	command -v "$t" >/dev/null 2>&1 || bad "tool-$t" "not on PATH"
done
[ "$fails" -gt 0 ] && exit "$fails"

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
[ -d "$XDG_RUNTIME_DIR" ] || { bad "runtime-dir" "$XDG_RUNTIME_DIR does not exist"; exit "$fails"; }

# -------------------------------------------------------------- headless hedl
#
# Its own HEDLDIR, so this never touches the socket a running desktop owns and
# two of these can run at once.

dir="$tmp/run"
echo 'hedl.bind("SUPER + Q", "quit", hedl.dsp.quit())' > "$tmp/hedl.lua"

WLR_BACKENDS=headless \
WLR_LIBINPUT_NO_DEVICES=1 \
HEDL_CONFIG="$tmp/hedl.lua" \
HEDLDIR="$dir" \
	hedl >"$tmp/hedl.log" 2>&1 &
hedl_pid=$!

n=0
while [ ! -S "$dir/kipp" ] && [ "$n" -lt 100 ]; do
	kill -0 "$hedl_pid" 2>/dev/null || break
	n=$((n + 1))
	sleep 0.1
done

if [ ! -S "$dir/kipp" ]; then
	bad "hedl-headless" "no socket after 10s; log: $(tr '\n' ' ' < "$tmp/hedl.log" | tail -c 200)"
	exit "$fails"
fi
ok "hedl-headless"
[ -p "$dir/cmd" ] && ok "hedl-cmd-fifo" || bad "hedl-cmd-fifo" "$dir/cmd is not a fifo"

# ------------------------------------------------------------- the kipp stream
#
# A consumer connects and is told everything: a version line, the whole current
# state, then sync. No seed source, because there is nothing to prime.

socat -u UNIX-CONNECT:"$dir/kipp" - > "$tmp/kipp.out" 2>/dev/null &
sock_pid=$!
sleep 1
printf 'view\t4\n' > "$dir/cmd"
printf 'setlayout\tmonocle\n' > "$dir/cmd"
sleep 1
kill "$sock_pid" 2>/dev/null

for kind in version mon focus tags layout sync; do
	if grep -q "^$kind	" "$tmp/kipp.out"; then
		ok "kipp-$kind"
	else
		bad "kipp-$kind" "no $kind line on the socket"
	fi
done

# The session order the spec asks for. A consumer that acts before sync is
# acting on half a picture, so sync has to come after the state and not with it.
if [ "$(head -1 "$tmp/kipp.out" | cut -f1)" = version ]; then
	ok "kipp-version-first"
else
	bad "kipp-version-first" "first line is $(head -1 "$tmp/kipp.out" | cut -f1)"
fi
# Compared as a NUMBER. This used to grep the line number for [3-9], which
# reads "not line 1 or 2" only while the dump is under ten lines: hedl grew a
# title, an app, a win and a bind line, sync landed on line 10, and the check
# started failing on an image that was correct.
sync_at=$(awk -F'\t' '$1=="sync"{print NR; exit}' "$tmp/kipp.out")
if [ -n "$sync_at" ] && [ "$sync_at" -ge 3 ]; then
	ok "kipp-sync-after-state"
else
	bad "kipp-sync-after-state" "sync on line ${sync_at:-none} of $(wc -l < "$tmp/kipp.out")"
fi

# A command on the fifo has to move the state on the socket. This is the whole
# loop: something outside writes a line, and every reader sees the result.
if awk -F'\t' '$1=="layout" && $3=="name=monocle"' "$tmp/kipp.out" | grep -q .; then
	ok "cmd-drives-state"
else
	bad "cmd-drives-state" "setlayout on the fifo did not reach the socket"
fi

# The subject of a focus is a monitor. An adapter or a publisher that names a
# tag here instead makes every consumer that keys on the monitor draw twice.
# Checking the line exists does not catch it; checking what it names does.
mons=$(awk -F'\t' '$1=="mon" { print $2 }' "$tmp/kipp.out" | sort -u)
seen=$(awk -F'\t' '$1=="focus" { print $2 }' "$tmp/kipp.out" | sort -u)
stray=$(printf '%s\n' $seen | grep -vxF "$mons" || true)
if [ -z "$seen" ]; then
	bad "kipp-focus-subject" "no focus subject to check"
elif [ -n "$stray" ]; then
	bad "kipp-focus-subject" "focus names $(echo $stray), which is no monitor"
else
	ok "kipp-focus-subject"
fi

# ----------------------------------------------------------------- kippsrv
#
# Skipped when kippsrv is not installed, so this file is useful before the
# shell is vendored into the image.

if ! command -v kippsrv >/dev/null 2>&1; then
	skip "kippsrv-hedl" "kippsrv not installed"
	hedlquit
	exit "$fails"
fi

adapter=/usr/share/kippsrv/lua/wm/hedl.lua
if [ ! -f "$adapter" ]; then
	skip "kippsrv-hedl" "$adapter not installed"
	exit "$fails"
fi

cat > "$tmp/kipp.lua" <<EOF
return {
	socket = "$tmp/kippsrv.sock",
	sources = {
		{ name = "wm", adapter = "$adapter", sock = "$dir/kipp" },
	},
}
EOF

kippsrv "$tmp/kipp.lua" >"$tmp/kippsrv.log" 2>&1 &
kipp_pid=$!

n=0
while [ ! -S "$tmp/kippsrv.sock" ] && [ "$n" -lt 50 ]; do
	n=$((n + 1))
	sleep 0.1
done

if [ ! -S "$tmp/kippsrv.sock" ]; then
	bad "kippsrv-hedl" "no socket; log: $(tr '\n' ' ' < "$tmp/kippsrv.log" | tail -c 200)"
	exit "$fails"
fi

socat -u UNIX-CONNECT:"$tmp/kippsrv.sock" - > "$tmp/shell.out" 2>/dev/null &
sock_pid=$!
sleep 1
printf 'view\t7\n' > "$dir/cmd"
sleep 1
kill "$sock_pid" 2>/dev/null

# What hedl said has to come out the other side. If the adapter ever needs a
# rule, the two formats have drifted and this is where it shows.
for kind in tags focus layout; do
	if grep -q "^$kind	" "$tmp/shell.out"; then
		ok "shell-$kind"
	else
		bad "shell-$kind" "kippsrv did not republish $kind"
	fi
done

hedlquit
exit "$fails"
