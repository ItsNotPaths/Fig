#!/bin/sh
# Show everything kippsrv is saying, on a wweft surface.
#
# The panel is /usr/local/share/fig/kipp-probe.lua. It takes a kipp line
# apart the way the spec says to and names no kind, so it shows whatever the
# adapters produce today.
#
#   test-wweft                 the session's kippsrv
#   test-wweft <socket>        some other one
#
# q quits, c clears, r hides the raw lines.
set -eu

PANEL=/usr/local/share/fig/kipp-probe.lua
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/kippsrv/kippsrv.lua

sock="${1:-${XDG_RUNTIME_DIR:-/tmp}/kippsrv.sock}"

if [ ! -S "$sock" ]; then
	# The session normally starts it. Starting one here makes the panel
	# useful from a bare tty as well.
	echo "test-wweft: no socket at $sock, starting kippsrv"
	kippsrv "$CONFIG" >"${XDG_RUNTIME_DIR:-/tmp}/kippsrv.log" 2>&1 &

	n=0
	while [ ! -S "$sock" ] && [ "$n" -lt 50 ]; do
		n=$((n + 1))
		sleep 0.1
	done
	[ -S "$sock" ] || {
		echo "test-wweft: kippsrv never opened $sock. Its log:" >&2
		cat "${XDG_RUNTIME_DIR:-/tmp}/kippsrv.log" >&2
		exit 1
	}
fi

exec wweft "$PANEL" "$sock"
