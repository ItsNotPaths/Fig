#!/bin/bash
# The applications, for the launcher.
#
#   app-list     name<TAB>command, one for each .desktop worth showing
#
# A .desktop file is an ini file with a [Desktop Entry] group and, sometimes,
# [Desktop Action ...] groups after it. Only the first group is an application,
# so the rest are skipped rather than listed as if they were.
#
# What is skipped is the freedesktop rule and nothing of our own: NoDisplay,
# Hidden, a Type that is not Application, and the two show-in keys. There is no
# list here of programs somebody decided were boring. A package that ships a
# .desktop file is saying it wants to be in a launcher, and the way to disagree
# is NoDisplay in a file of your own under ~/.local/share/applications, which
# the loop below already prefers.
#
# Terminal=true means the program draws in a terminal and has none of its own,
# so the command is wrapped here. Which terminal is a machine fact, and a
# surface should not have to know it.

set -uo pipefail

TERM_CMD=${TERMINAL:-foot}

# Who we are, for OnlyShowIn and NotShowIn. Three variables because no single
# one of them is reliably set, and the keys are matched against any of them.
DESKTOPS="${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:${DESKTOP_SESSION:-}"

IFS=: read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

dirs=("${XDG_DATA_HOME:-$HOME/.local/share}/applications")
for d in "${data_dirs[@]}"; do dirs+=("$d/applications"); done

# id<TAB>path, in precedence order. The id is the path under the applications
# directory with the separators turned into dashes, which is what makes a file
# in the home directory shadow the one in /usr/share rather than sit beside it.
# Subdirectories are legal and carry ids, so this is not a maxdepth 1 find.
pairs=()
for d in "${dirs[@]}"; do
	[ -d "$d" ] || continue
	while IFS= read -r -d '' f; do
		rel=${f#"$d"/}
		pairs+=("${rel%.desktop}"$'\t'"$f")
	done < <(find "$d" -type f -name '*.desktop' -print0 2>/dev/null | sort -z)
done
[ ${#pairs[@]} -gt 0 ] || exit 0

printf '%s\n' "${pairs[@]}" | awk -F'\t' -v term="$TERM_CMD" -v desktops="$DESKTOPS" '
	function shows_in(list,   i, j, mine, theirs) {
		# Either list is semicolon separated; ours is colon separated.
		split(desktops, mine, ":")
		split(list, theirs, ";")
		for (i in mine)
			for (j in theirs)
				if (mine[i] != "" && mine[i] == theirs[j]) return 1
		return 0
	}

	function flush(  cmd) {
		if (name != "" && exec != "" && type == "Application" &&
		    !nodisplay && !hidden &&
		    (only == "" || shows_in(only)) &&
		    (notshow == "" || !shows_in(notshow))) {
			cmd = exec
			gsub(/%[fFuUickvm]/, "", cmd)   # field codes: nothing is being opened
			gsub(/[ \t]+$/, "", cmd)
			if (terminal) cmd = term " -e " cmd
			print name "\t" cmd
		}
		name = ""; exec = ""; type = ""; only = ""; notshow = ""
		nodisplay = 0; hidden = 0; terminal = 0; entry = 0
	}

	# One line an id, in precedence order. A second file with an id already
	# taken is the one being shadowed, so it is never opened.
	{
		id = $1
		if (id in seen) next
		seen[id] = 1

		flush()
		while ((getline line < $2) > 0) {
			if (line ~ /^\[/) { entry = (line == "[Desktop Entry]"); continue }
			if (!entry) continue
			# The first Name and Exec win, so a localised Name[de] later in
			# the file is ignored.
			if (line ~ /^Name *=/ && name == "") { sub(/^Name *= */, "", line); name = line }
			else if (line ~ /^Exec *=/ && exec == "") { sub(/^Exec *= */, "", line); exec = line }
			else if (line ~ /^Type *=/) { sub(/^Type *= */, "", line); type = line }
			else if (line ~ /^OnlyShowIn *=/) { sub(/^OnlyShowIn *= */, "", line); only = line }
			else if (line ~ /^NotShowIn *=/) { sub(/^NotShowIn *= */, "", line); notshow = line }
			else if (line ~ /^Terminal *= *true/) terminal = 1
			else if (line ~ /^NoDisplay *= *true/) nodisplay = 1
			else if (line ~ /^Hidden *= *true/) hidden = 1
		}
		close($2)
	}
	END { flush() }
' | sort -u -t$'\t' -k1,1f
