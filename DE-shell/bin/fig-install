#!/bin/bash
# fig-install - put fig on a disk.
#
# The whole of it is here and none of it is in a surface. The wweft installer
# writes an answer file and watches the log; this reads the answer file and
# does the work. That split is what makes it testable in a VM with no screen,
# and what stops a crashed surface from stranding a half-installed disk.
#
#   fig-install --answers <file> [--dry-run] [--yes]
#
# The answer file is shell, so a Lua surface writes it with string.format and
# nothing has to parse anything:
#
#   FIG_MODE=whole-disk          whole-disk | use-partition
#   FIG_DISK=/dev/vda            whole-disk: the disk to erase
#   FIG_ROOT_PART=/dev/vda2      use-partition: what to put the root on
#   FIG_ESP_PART=/dev/vda1       use-partition: an ESP that already exists
#   FIG_LUKS_PASS_FILE=/run/x    the passphrase, its own file, mode 600
#   FIG_HOSTNAME=fig             defaults: fig, UTC, en_US.UTF-8, us, fig
#   FIG_TIMEZONE=Europe/Berlin
#   FIG_LOCALE=en_US.UTF-8
#   FIG_KEYMAP=us
#   FIG_USER=paths
#   FIG_USER_PASS_FILE=/run/y    that user's password, its own file
#   FIG_ROOT_PASS_FILE=/run/z    root's password. Unset locks root instead
#   FIG_CONSOLE=ttyS0,115200     a serial console. Unset on anything with a screen
#
# Passphrases are never in the answer file. It is written to disk to be read
# back and logged; the passphrase is read once from a file under /run.
set -uo pipefail

ESP_SIZE=1GiB
SUBVOLS="@ @home @snapshots @log @pkg"
MOUNT=/mnt

dry=0 yes=0 answers=""
while [ $# -gt 0 ]; do
	case "$1" in
	--answers) shift; answers=${1:-} ;;
	-n | --dry-run) dry=1 ;;
	-y | --yes) yes=1 ;;
	-h | --help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "fig-install: unknown argument $1" >&2; exit 2 ;;
	esac
	shift
done

say()  { printf '==> %s\n' "$*"; }
die()  { printf 'fig-install: %s\n' "$*" >&2; exit 1; }
run()  { if [ "$dry" = 1 ]; then printf '    would: %s\n' "$*"; else "$@" || die "failed: $*"; fi; }

[ "$(id -u)" = 0 ] || die "needs root"
[ -n "$answers" ] || die "no --answers file"
[ -r "$answers" ] || die "cannot read $answers"

# Sourced, so it is shell and not a format anyone has to write a parser for.
# It is also arbitrary code, which is why the surface writes it and nothing
# else does.
# shellcheck disable=SC1090
. "$answers"

: "${FIG_MODE:?FIG_MODE is not set}"

# --------------------------------------------------------------- refusals
#
# Every one of these has to pass before a single byte is written. They are
# here rather than beside the thing they guard so that the whole list can be
# read at once, which is the only way anyone checks it.

booted_disk() {
	# What the live system is running from, so it is never the target.
	local src
	src=$(findmnt -no SOURCE / 2>/dev/null) || return 0
	case "$src" in
	/dev/*) lsblk -no PKNAME "$src" 2>/dev/null | head -1 ;;
	*) # A live ISO roots on a loop or an overlay. Follow the ISO instead.
	   findmnt -no SOURCE /run/artix/bootmnt 2>/dev/null |
		   sed 's|^/dev/||;s|[0-9]*$||' ;;
	esac
}

refuse_if_in_use() {
	local dev=$1 held
	held=$(lsblk -nro MOUNTPOINT "$dev" 2>/dev/null | grep -v '^$' | tr '\n' ' ')
	[ -z "$held" ] || die "$dev has something mounted on it: $held"
}

refuse_if_booted() {
	local dev=$1 boot
	boot=$(booted_disk)
	[ -n "$boot" ] || return 0
	case "$dev" in
	*"$boot"*) die "$dev is what this system booted from" ;;
	esac
}

case "$FIG_MODE" in
whole-disk)
	: "${FIG_DISK:?FIG_DISK is not set}"
	[ -b "$FIG_DISK" ] || die "$FIG_DISK is not a block device"
	[ -z "$(lsblk -nro TYPE "$FIG_DISK" | grep -x part)" ] ||
		lsblk -nro TYPE "$FIG_DISK" | grep -qx disk ||
		die "$FIG_DISK is not a whole disk"
	refuse_if_booted "$FIG_DISK"
	refuse_if_in_use "$FIG_DISK"
	target=$FIG_DISK
	;;
use-partition)
	: "${FIG_ROOT_PART:?FIG_ROOT_PART is not set}"
	: "${FIG_ESP_PART:?FIG_ESP_PART is not set, and use-partition cannot make one}"
	[ -b "$FIG_ROOT_PART" ] || die "$FIG_ROOT_PART is not a block device"
	[ -b "$FIG_ESP_PART" ]  || die "$FIG_ESP_PART is not a block device"
	# The ESP is reused and never formatted: on a dual-boot machine it holds
	# somebody else's bootloader, and fig's job is to land beside it.
	[ "$(lsblk -nro FSTYPE "$FIG_ESP_PART")" = vfat ] ||
		die "$FIG_ESP_PART is not a FAT filesystem, so it is not an ESP"
	refuse_if_booted "$FIG_ROOT_PART"
	refuse_if_in_use "$FIG_ROOT_PART"
	refuse_if_in_use "$FIG_ESP_PART"
	target=$FIG_ROOT_PART
	;;
*) die "FIG_MODE is '$FIG_MODE', not whole-disk or use-partition" ;;
esac

: "${FIG_LUKS_PASS_FILE:?FIG_LUKS_PASS_FILE is not set}"
[ -r "$FIG_LUKS_PASS_FILE" ] || die "cannot read $FIG_LUKS_PASS_FILE"
[ -s "$FIG_LUKS_PASS_FILE" ] || die "$FIG_LUKS_PASS_FILE is empty"

# --------------------------------------------------------------- consent
say "target: $target ($FIG_MODE)"
echo
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT "${FIG_DISK:-$FIG_ROOT_PART}" 2>/dev/null
echo
if [ "$FIG_MODE" = whole-disk ]; then
	say "everything above is erased."
else
	say "$FIG_ROOT_PART is erased. $FIG_ESP_PART is written to but not formatted."
fi

if [ "$dry" = 0 ] && [ "$yes" = 0 ]; then
	printf 'Type ERASE to go ahead: '
	read -r reply
	[ "$reply" = ERASE ] || die "not confirmed"
fi

# ------------------------------------------------------------- partition
part_path() {
	# nvme and mmc put a p between the disk and the number. Taken from
	# omarchy-iso's disk-partitioning.sh, which learned it the hard way.
	case "$1" in
	*nvme* | *mmcblk*) printf '%sp%s' "$1" "$2" ;;
	*) printf '%s%s' "$1" "$2" ;;
	esac
}

wait_for_device() {
	local i
	for i in $(seq 1 10); do
		[ -b "$1" ] && return 0
		udevadm settle 2>/dev/null || true
		sleep 1
	done
	die "$1 never appeared"
}

if [ "$FIG_MODE" = whole-disk ]; then
	say "partitioning $FIG_DISK"
	run wipefs --all --force "$FIG_DISK"
	run sgdisk --zap-all "$FIG_DISK"
	run sgdisk \
		--new=1:0:+$ESP_SIZE --typecode=1:ef00 --change-name=1:FIGBOOT \
		--new=2:0:0         --typecode=2:8309 --change-name=2:FIGROOT \
		"$FIG_DISK"
	run partprobe "$FIG_DISK"
	esp=$(part_path "$FIG_DISK" 1)
	root=$(part_path "$FIG_DISK" 2)
	[ "$dry" = 1 ] || wait_for_device "$esp"
	[ "$dry" = 1 ] || wait_for_device "$root"
	say "formatting the ESP"
	run mkfs.fat -F32 -n FIGBOOT "$esp"
else
	esp=$FIG_ESP_PART
	root=$FIG_ROOT_PART
fi

# ------------------------------------------------------------------ luks
#
# luks2 with cryptsetup's own defaults. The argon2id cost is measured against
# the machine doing the formatting, which here is the machine that will be
# unlocking it, so there is nothing to tune and nothing to get wrong.
say "encrypting $root"
if [ "$dry" = 1 ]; then
	echo "    would: cryptsetup luksFormat --type luks2 $root"
	echo "    would: cryptsetup open $root cryptroot"
else
	cryptsetup luksFormat --type luks2 --batch-mode \
		--key-file "$FIG_LUKS_PASS_FILE" "$root" || die "luksFormat failed"
	cryptsetup open --key-file "$FIG_LUKS_PASS_FILE" "$root" cryptroot ||
		die "cryptsetup open failed"
fi
mapper=/dev/mapper/cryptroot

# ----------------------------------------------------------------- btrfs
#
# The subvolume layout is the one decision here that is expensive to undo. `@`
# and `@snapshots` are siblings at the btrfs root and `/` is mounted with
# subvol=@, which is what lets a snapshot be rolled back into place later.
# Mounting the btrfs root as `/` instead would work today and close that door.
say "btrfs on $mapper"
run mkfs.btrfs -f -L fig "$mapper"
run mount "$mapper" "$MOUNT"
for v in $SUBVOLS; do run btrfs subvolume create "$MOUNT/$v"; done
run umount "$MOUNT"

opts="noatime,compress=zstd:3,space_cache=v2"
say "mounting"
run mount -o "$opts,subvol=@" "$mapper" "$MOUNT"
run mkdir -p "$MOUNT/home" "$MOUNT/.snapshots" "$MOUNT/var/log" \
	"$MOUNT/var/cache/pacman/pkg" "$MOUNT/boot"
run mount -o "$opts,subvol=@home"      "$mapper" "$MOUNT/home"
run mount -o "$opts,subvol=@snapshots" "$mapper" "$MOUNT/.snapshots"
run mount -o "$opts,subvol=@log"       "$mapper" "$MOUNT/var/log"
run mount -o "$opts,subvol=@pkg"       "$mapper" "$MOUNT/var/cache/pacman/pkg"
run mount "$esp" "$MOUNT/boot"

say "disk ready"
if [ "$dry" = 0 ]; then
	echo
	# -l, not the tree. The box-drawing characters do not survive a serial
	# console, and this output's whole job is to be read in a log.
	findmnt -lo TARGET,SOURCE,FSTYPE "$MOUNT" --submounts
	echo
	btrfs subvolume list "$MOUNT"
fi

# ------------------------------------------------------------------- base
#
# From the mirror on the ISO and nowhere else, so an install works with the
# cable out. The package set is whatever the live system is running, minus the
# four packages that only make sense on a live image: what you install is what
# you just booted and nothing else.
mirror=${FIG_MIRROR:-}
if [ -z "$mirror" ]; then
	mirror=$(dirname "$(find /run -name fig-mirror.db 2>/dev/null | head -1)" 2>/dev/null)
fi
[ -d "$mirror" ] || die "no package mirror. Looked for fig-mirror.db under /run"
say "mirror: $mirror"

LIVE_ONLY="artix-live-base artix-live-runit artix-grub-live squashfs-tools"

conf=$(mktemp)
cat > "$conf" <<EOF
[options]
HoldPkg = pacman glibc
Architecture = auto
SigLevel = Optional TrustAll
LocalFileSigLevel = Optional TrustAll

[fig-mirror]
Server = file://$mirror
EOF

pkgs=$(pacman -Qq | grep -vxF "$(printf '%s\n' $LIVE_ONLY)" | tr '\n' ' ')
say "installing $(printf '%s' "$pkgs" | wc -w) packages"
if [ "$dry" = 1 ]; then
	echo "    would: basestrap -C $conf $MOUNT <$(printf '%s' "$pkgs" | wc -w) packages>"
else
	# shellcheck disable=SC2086
	basestrap -C "$conf" "$MOUNT" $pkgs || die "basestrap failed"
fi

# ------------------------------------------------------ the root overlay
#
# buildiso copies profile/fig/root-overlay onto the ISO's filesystem after
# pacman has finished, so none of it belongs to a package, and basestrap
# installs packages. Without this an installed machine has no
# ~/.bash_profile to start the session and no ~/.config/hedl/hedl.lua to give
# it keys: it boots to a bare tty and `hedl` comes up with no desktop at all.
#
# Packaging them instead does not work. /etc/skel/.bashrc and .bash_profile
# belong to `bash`, and a second package claiming them is a file conflict
# pacman refuses.
#
# So they are copied off the running live image, which is the same tree the
# overlay was applied to. Two are left behind on purpose, both true of a live
# image and wrong on a machine: the tty1 autologin, and NOPASSWD for wheel.
#
# ANYTHING ADDED TO root-overlay MUST BE ADDED HERE or it reaches the ISO and
# no machine installed from it.
OVERLAY="
/etc/skel
/etc/fonts/conf.d/10-fig.conf
/usr/local/bin/fig-selftest
/usr/local/bin/test-wweft
/usr/local/share/fig
/usr/share/dbus-1/system-services/org.freedesktop.login1.service
"

say "the files no package owns"
for src in $OVERLAY; do
	[ -e "$src" ] || { say "  missing on the live image: $src"; continue; }
	if [ "$dry" = 1 ]; then
		echo "    would: cp -a $src -> $MOUNT$src"
	elif [ -d "$src" ]; then
		# The contents, not the directory. /etc/skel already exists on the
		# target because bash owns it, and copying the directory into it
		# would leave /etc/skel/skel.
		mkdir -p "$MOUNT$src"
		cp -a "$src/." "$MOUNT$src/" || die "cannot copy $src"
	else
		mkdir -p "$MOUNT$(dirname "$src")"
		cp -a "$src" "$MOUNT$src" || die "cannot copy $src"
	fi
done

say "fstab"
if [ "$dry" = 1 ]; then
	echo "    would: fstabgen -U $MOUNT >> $MOUNT/etc/fstab"
else
	fstabgen -U "$MOUNT" >> "$MOUNT/etc/fstab" || die "fstabgen failed"
fi

# ----------------------------------------------------------------- chroot
#
# One script written into the target and run there, rather than twenty
# artix-chroot calls. It is easier to read, and a failure names the line.
luks_uuid=$(blkid -s UUID -o value "$root" 2>/dev/null)
[ -n "$luks_uuid" ] || [ "$dry" = 1 ] || die "no UUID on $root"

: "${FIG_HOSTNAME:=fig}"
: "${FIG_TIMEZONE:=UTC}"
: "${FIG_LOCALE:=en_US.UTF-8}"
: "${FIG_KEYMAP:=us}"
: "${FIG_USER:=fig}"

# A machine with no screen. FIG_CONSOLE=ttyS0,115200 puts the kernel and the
# initramfs passphrase prompt on a serial port, which is the only way to
# install onto a headless box and the only way the VM test can watch one boot.
# Off by default: the last console= on the line owns /dev/console, so setting
# this on a laptop would send the passphrase prompt somewhere nobody is looking.
cmdline_extra=""
[ -n "${FIG_CONSOLE:-}" ] && cmdline_extra=" console=tty0 console=$FIG_CONSOLE"

say "configuring the new system"
if [ "$dry" = 1 ]; then
	echo "    would: hostname $FIG_HOSTNAME, tz $FIG_TIMEZONE, locale $FIG_LOCALE"
	echo "    would: mkinitcpio with the encrypt hook, then grub with"
	echo "           cryptdevice=UUID=<$root>:cryptroot rootflags=subvol=@"
	echo "    would: create $FIG_USER, enable NetworkManager bluetoothd acpid agetty-ttyS0"
	say "dry run complete"
	exit 0
fi

install -Dm600 "${FIG_USER_PASS_FILE:-/dev/null}" "$MOUNT/root/.fig-userpass" 2>/dev/null || true
install -Dm600 "${FIG_ROOT_PASS_FILE:-/dev/null}" "$MOUNT/root/.fig-rootpass" 2>/dev/null || true

cat > "$MOUNT/root/fig-configure" <<EOF
#!/bin/bash
set -eu

echo "$FIG_HOSTNAME" > /etc/hostname
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s\n' "$FIG_HOSTNAME" > /etc/hosts

ln -sf "/usr/share/zoneinfo/$FIG_TIMEZONE" /etc/localtime
hwclock --systohc || true

sed -i 's/^#\\($FIG_LOCALE\\)/\\1/' /etc/locale.gen
locale-gen
echo "LANG=$FIG_LOCALE" > /etc/locale.conf
echo "KEYMAP=$FIG_KEYMAP" > /etc/vconsole.conf

# encrypt before filesystems, and only once however many times this runs.
#
# The HOOKS line and nothing else. mkinitcpio.conf ships a comment block that
# lists every available hook by name, so grepping the whole file for "encrypt"
# matches the documentation and reports success on a system that cannot unlock
# its own root. It did exactly that once.
hooks() { grep -m1 '^HOOKS=' /etc/mkinitcpio.conf; }
hooks >/dev/null || { echo "no HOOKS line in mkinitcpio.conf" >&2; exit 1; }
case "\$(hooks)" in
*encrypt*) ;;
*) sed -i 's/^\(HOOKS=.*\)filesystems/\1encrypt filesystems/' /etc/mkinitcpio.conf ;;
esac
case "\$(hooks)" in
*encrypt*) ;;
*) echo "could not put encrypt in: \$(hooks)" >&2; exit 1 ;;
esac
mkinitcpio -P

# And prove it landed in the image, not just in the file that asks for it.
lsinitcpio /boot/initramfs-linux.img | grep -q 'hooks/encrypt' ||
	{ echo "the initramfs has no encrypt hook" >&2; exit 1; }

# /boot is the ESP and is not encrypted, so grub never reads LUKS. The initramfs
# asks for the passphrase instead, which is what cryptdevice= tells it to do.
sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT="cryptdevice=UUID=$luks_uuid:cryptroot root=/dev/mapper/cryptroot rootflags=subvol=@ rw$cmdline_extra"|' \\
	/etc/default/grub
# --removable as well as the NVRAM entry: a VM with no persistent NVRAM, and
# some firmware that forgets, both boot the fallback path instead.
grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=fig --removable
grub-mkconfig -o /boot/grub/grub.cfg

id -u "$FIG_USER" >/dev/null 2>&1 || useradd -m -G wheel,video,audio,input,storage "$FIG_USER"
if [ -s /root/.fig-userpass ]; then
	printf '%s:%s' "$FIG_USER" "\$(cat /root/.fig-userpass)" | chpasswd
fi
# Root gets a password only when one was given. The installer surface hands it
# the same secret as the disk and the login, which is omarchy's arrangement and
# means one thing to remember. An answer file that names no root password locks
# the account instead, and sudo through wheel is the only way up.
if [ -s /root/.fig-rootpass ]; then
	printf 'root:%s' "\$(cat /root/.fig-rootpass)" | chpasswd
else
	passwd -l root
fi
rm -f /root/.fig-userpass /root/.fig-rootpass

# wheel gets sudo. Artix ships the line commented in its own sudoers.
sed -i 's/^# \\(%wheel ALL=(ALL:ALL) ALL\\)/\\1/' /etc/sudoers

# The four the packages do not link for themselves. dbus, logind, udevd and the
# six agettys come with their own packages; these do not.
mkdir -p /etc/runit/runsvdir/default
for s in NetworkManager bluetoothd acpid agetty-ttyS0; do
	[ -d "/etc/runit/sv/\$s" ] && ln -sfn "/etc/runit/sv/\$s" "/etc/runit/runsvdir/default/\$s"
done
# Live-only, and it would try to re-key pacman on every boot.
rm -f /etc/runit/runsvdir/default/pacman-init
EOF

chmod +x "$MOUNT/root/fig-configure"
artix-chroot "$MOUNT" /root/fig-configure || die "configuring the new system failed"
rm -f "$MOUNT/root/fig-configure"

say "installed"
