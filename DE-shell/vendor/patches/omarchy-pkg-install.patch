+# fig: the live image ships an empty /var/lib/pacman/sync, so `pacman -Slq`
+# prints nothing on a fresh boot and this panel would open with no rows in it.
+# The AUR panel does not need this: `yay -Slqa` asks the network.
+if [[ -z $(pacman -Slq 2>/dev/null | head -n1) ]]; then
+  sudo pacman -Sy
+fi
+
